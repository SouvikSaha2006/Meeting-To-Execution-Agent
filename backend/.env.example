# ─────────────────────────────────────────────
# Google Gemini API
# ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────
# Demo / Fallback Mode
# Set to "true" to bypass Gemini API calls and
# use deterministic mock responses (useful for
# live demos under rate limits or offline mode)
# ─────────────────────────────────────────────
DEMO_MODE=false

# ─────────────────────────────────────────────
# GitHub Integration (optional)
# When set, approved ACTION_ITEM tasks will
# automatically create GitHub Issues.
# ─────────────────────────────────────────────
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO=owner/repository-name

# ─────────────────────────────────────────────
# Slack / Discord Webhook (optional)
# Generic outbound webhook for notifications
# ─────────────────────────────────────────────
WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ─────────────────────────────────────────────
# Database
# Default: SQLite (zero-setup). Override with
# a full PostgreSQL DSN for production.
# ─────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./meeting_agent.db

# ─────────────────────────────────────────────
# App Settings
# ─────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
